{
    "name": "crustum/mcp",
    "description": "MCP plugin for CakePHP applications",
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "6.x-dev",
        "crustum/tessera": "2.x-dev",
        "crustum/json-schema": "^1.0",
        "symfony/process": "^7.4.5|^8.0.5"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.19",
        "cakephp/bake": "4.x-dev",
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "crustum/plugin-manifest": "2.x-dev",
        "jasonmccreary/double": "1.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestApp\\": "tests/TestApp/",
            "Crustum\\Mcp\\Test\\": "tests/",
            "Crustum\\Mcp\\Server\\Conformance\\": "tests/Conformance/",
            "Crustum\\Mcp\\Facades\\": "tests/Support/Facades/"
        },
        "files": []
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@stan"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/",
        "test": "pest --compact",
        "test:unit": "pest --compact --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration",
        "test:coverage": "pest --coverage",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "crustum/plugin-manifest": "CakePHP plugin installer"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform-check": false
    }
}
